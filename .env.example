# Server
PORT=3000
NODE_ENV=development

# Neon PostgreSQL
# Copy this from Neon Console -> Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# JWT secrets - replace both with long random values
JWT_SECRET=replace-with-a-long-random-user-secret
ADMIN_JWT_SECRET=replace-with-a-long-random-admin-secret
SETUP_JWT_SECRET=replace-with-a-long-random-setup-secret

# 32-byte key in hexadecimal (64 hex characters).
# Generate with: node scripts/generate-secret.js
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Session cookie
COOKIE_MAX_AGE_MS=86400000

# Google Authenticator
TOTP_ISSUER=MFA Auth

# --- Email ---
# Gmail: enable 2-Step Verification and create a Google App Password.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="MFA Auth <your-email@gmail.com>"
